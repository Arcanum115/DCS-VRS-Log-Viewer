<Window x:Class="DCSLogViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DCSLogViewer.Converters"
        xmlns:vm="clr-namespace:DCSLogViewer.ViewModels"
        xmlns:models="clr-namespace:DCSLogViewer.Models"
        xmlns:controls="clr-namespace:DCSLogViewer.Controls"
        Title="VRS // DCS Log Viewer"
        Height="900" Width="1400"
        MinHeight="600" MinWidth="1000"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:LogLevelToColorConverter x:Key="LevelToColor" />
        <converters:LogLevelToBackgroundConverter x:Key="LevelToBackground" />
        <converters:LogLevelToLabelConverter x:Key="LevelToLabel" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />

        <!-- Sidebar button style -->
        <Style x:Key="SidebarBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="Nav" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgLightBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="3,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1E1438" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#FF141226" Opacity="0.85" />
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======== SIDEBAR ======== -->
        <Border Grid.Column="0" Grid.RowSpan="2"
                Background="{StaticResource BgMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App title with VRS logo -->
                <Border DockPanel.Dock="Top" Padding="16,10,16,8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="/Assets/VRS_Logo.png" Width="120" Height="120"
                               RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,6" />
                        <TextBlock Text="DCS LOG VIEWER" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource AccentGreenBrush}" FontFamily="Consolas"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <RadioButton Content="Launcher" Style="{StaticResource SidebarBtn}" IsChecked="True"
                                 Command="{Binding NavigateToCommand}" CommandParameter="Launcher" />
                    <RadioButton Content="Log Viewer" Style="{StaticResource SidebarBtn}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="LogViewer" />
                    <RadioButton Content="System &amp; DCS Info" Style="{StaticResource SidebarBtn}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="Performance" />
                    <RadioButton Content="DCS Optimization" Style="{StaticResource SidebarBtn}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="FpsGuide" />
                    <RadioButton Content="Windows Tweaks" Style="{StaticResource SidebarBtn}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="WinTweaks" />
                </StackPanel>

                <!-- Bottom info -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,12" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Config.DcsVariant, StringFormat='Variant: {0}'}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                </StackPanel>

                <Border /> <!-- Spacer -->
            </DockPanel>
        </Border>

        <!-- ======== CONTENT AREA ======== -->
        <Grid Grid.Column="1" Grid.Row="0">

            <!-- Animated synthwave background -->
            <controls:SynthwaveBackground />

            <!-- LAUNCHER PANEL -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActivePanel}" Value="Launcher">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel Margin="20">
                    <TextBlock Text="LAUNCHER" Style="{StaticResource SectionHeader}" />

                    <!-- DCS Launch -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="DCS World" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Launcher.DcsStatus}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Launch DCS" Style="{StaticResource ToolbarButton}"
                                        FontSize="13" Padding="16,8"
                                        Command="{Binding Launcher.LaunchDcsCommand}" />
                                <Button Content="Browse DCS Path..." Style="{StaticResource ToolbarButton}"
                                        Command="{Binding Launcher.BrowseDcsPathCommand}" />
                                <Button Content="Refresh" Style="{StaticResource ToolbarButton}"
                                        Command="{Binding Launcher.RefreshStatusCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- External Tools -->
                    <TextBlock Text="External Tools" Style="{StaticResource SubHeader}"
                               Foreground="{StaticResource AccentBlueBrush}" />

                    <ItemsControl ItemsSource="{Binding Launcher.Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Launch" Style="{StaticResource ToolbarButton}"
                                                    Command="{Binding DataContext.Launcher.LaunchToolCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Get It" Style="{StaticResource ToolbarButton}" FontSize="11"
                                                    Foreground="#FF00CCFF" ToolTip="Open download page in browser"
                                                    Command="{Binding DataContext.Launcher.OpenProjectPageCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Browse" Style="{StaticResource ToolbarButton}" FontSize="11"
                                                    Command="{Binding DataContext.Launcher.BrowseToolPathCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="X" Style="{StaticResource ToolbarButton}" FontSize="11"
                                                    Foreground="#FFDD5555"
                                                    Command="{Binding DataContext.Launcher.RemoveToolCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ExePath, TargetNullValue='(no path set)'}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ Add Custom Tool" Style="{StaticResource ToolbarButton}"
                                Command="{Binding Launcher.AddToolCommand}" />
                    </StackPanel>

                    <!-- Suggested tools -->
                    <TextBlock Text="Suggested DCS Tools" Style="{StaticResource SubHeader}"
                               Foreground="{StaticResource AccentBlueBrush}" />
                    <TextBlock Text="Click a tool to browse for its .exe or open its download page."
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{x:Static models:ExternalTool.SuggestedTools}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" HorizontalAlignment="Left" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Style="{StaticResource ToolbarButton}" FontSize="13"
                                        Command="{Binding DataContext.Launcher.AddSuggestedToolCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Margin="0,0,6,6"
                                        Padding="14,8" HorizontalAlignment="Stretch" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Launcher status -->
                    <TextBlock Text="{Binding Launcher.StatusMessage}" Margin="0,12,0,0"
                               FontSize="11" Foreground="{StaticResource AccentGreenBrush}" />
                </StackPanel>
            </ScrollViewer>

            <!-- LOG VIEWER PANEL -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActivePanel}" Value="LogViewer">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Log toolbar -->
                <Border Grid.Row="0" Background="{StaticResource BgMediumBrush}"
                        Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LOG VIEWER" Style="{StaticResource SectionHeader}" Margin="0,0,20,0"
                                   VerticalAlignment="Center" />
                        <Button Content="Open File..." Style="{StaticResource ToolbarButton}"
                                Command="{Binding OpenFileCommand}" />
                        <Button Content="Auto-Detect" Style="{StaticResource ToolbarButton}"
                                Command="{Binding AutoDetectAndOpenCommand}" />
                        <ItemsControl ItemsSource="{Binding AvailableProfiles}" Margin="8,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Style="{StaticResource ToolbarButton}" FontSize="11"
                                            Command="{Binding DataContext.OpenProfileCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Tab control for open logs -->
                <TabControl Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                            Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderBrush}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <TextBlock Text="{Binding TabTitle}" VerticalAlignment="Center"
                                           Foreground="#FF7A70A0" />
                                <TextBlock Text="{Binding ErrorCount, StringFormat=' ({0})'}"
                                           Foreground="#FFDD5555" VerticalAlignment="Center" FontSize="10" Margin="4,0"
                                           Visibility="{Binding ErrorCount, Converter={StaticResource BoolToVis}}" />
                                <Button Content="X" FontSize="10" Padding="4,1" Cursor="Hand"
                                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>

                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:LogTabViewModel}">
                            <Grid Background="{StaticResource BgDarkBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Filter bar -->
                                <Border Grid.Row="0" Background="{StaticResource BgMediumBrush}" Padding="8,6"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <WrapPanel>
                                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Width="250" Style="{StaticResource SearchBox}"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,2" />
                                        <ToggleButton Content="TRC" IsChecked="{Binding ShowTrace}" Style="{StaticResource FilterToggle}" />
                                        <ToggleButton Content="DBG" IsChecked="{Binding ShowDebug}" Style="{StaticResource FilterToggle}" />
                                        <ToggleButton Content="INF" IsChecked="{Binding ShowInfo}" Style="{StaticResource FilterToggle}" />
                                        <ToggleButton Content="WRN" IsChecked="{Binding ShowWarning}" Style="{StaticResource FilterToggle}" Foreground="#FFD4B040" />
                                        <ToggleButton Content="ERR" IsChecked="{Binding ShowError}" Style="{StaticResource FilterToggle}" Foreground="#FFDD4545" />
                                        <ToggleButton Content="FTL" IsChecked="{Binding ShowFatal}" Style="{StaticResource FilterToggle}" Foreground="#FFCC3030" />
                                        <ToggleButton Content="---" IsChecked="{Binding ShowUnknown}" Style="{StaticResource FilterToggle}" />
                                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,2" />
                                        <Button Content="Errors Only" Style="{StaticResource ToolbarButton}" FontSize="11" Command="{Binding ShowErrorsOnlyCommand}" />
                                        <Button Content="Show All" Style="{StaticResource ToolbarButton}" FontSize="11" Command="{Binding ShowAllCommand}" />
                                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,2" />
                                        <CheckBox Content="Auto-Scroll" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" />
                                        <Button Content="Clear" Style="{StaticResource ToolbarButton}" FontSize="11" Command="{Binding ClearLogCommand}" />
                                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,2" />
                                        <Button Content="Scan Issues" Style="{StaticResource ToolbarButton}" FontSize="11" Command="{Binding ScanAllForIssuesCommand}"
                                                Foreground="#FF00CCFF" FontWeight="Bold" />
                                        <Button Style="{StaticResource ToolbarButton}" FontSize="11" Command="{Binding ToggleIssuesPanelCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Issues: " />
                                                <TextBlock Text="{Binding IssueCount}" FontWeight="Bold" Foreground="#FFDD5555" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Border>

                                <!-- Log list -->
                                <ListView Grid.Row="1" x:Name="LogListView"
                                          ItemsSource="{Binding FilteredEntries}"
                                          Background="{StaticResource BgDarkBrush}" BorderThickness="0"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          FontFamily="Cascadia Code,Consolas,Courier New" FontSize="12">
                                    <ListView.Resources>
                                        <Style TargetType="GridViewColumnHeader">
                                            <Setter Property="Background" Value="{StaticResource BgMediumBrush}" />
                                            <Setter Property="Foreground" Value="#FF605880" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="Padding" Value="6,4" />
                                            <Setter Property="FontSize" Value="11" />
                                        </Style>
                                    </ListView.Resources>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="#" Width="55">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding LineNumber}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Level" Width="50">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Level, Converter={StaticResource LevelToLabel}}"
                                                                   Foreground="{Binding Level, Converter={StaticResource LevelToColor}}" FontWeight="Bold" FontSize="11" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Category" Width="120">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Category}" Foreground="#FF4878A0" FontSize="11" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Message" Width="800">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Message}"
                                                                   Foreground="{Binding Level, Converter={StaticResource LevelToColor}}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Background" Value="{Binding Level, Converter={StaticResource LevelToBackground}}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="0,1" />
                                            <Setter Property="Foreground" Value="#FF706888" />
                                            <Setter Property="ToolTip" Value="{Binding RawLine}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#FF2A1848" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>

                                <!-- Detected Issues Panel -->
                                <Border Grid.Row="2" MaxHeight="280"
                                        Background="{StaticResource BgMediumBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                        Visibility="{Binding ShowIssuesPanel, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Background="#FF120E22" Padding="8,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"
                                                           VerticalAlignment="Center">
                                                    <Run Text="Detected Issues (" /><Run Text="{Binding IssueCount, Mode=OneWay}" /><Run Text=")" />
                                                </TextBlock>
                                                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource ToolbarButton}" FontSize="11"
                                                        Command="{Binding ToggleIssuesPanelCommand}" HorizontalAlignment="Right" />
                                                <TextBlock />
                                            </DockPanel>
                                        </Border>
                                        <ListView ItemsSource="{Binding DetectedIssues}"
                                                  Background="Transparent" BorderThickness="0"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  FontSize="12">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FF100C1E" CornerRadius="4" Padding="10,8" Margin="4,2" BorderBrush="#FF302858" BorderThickness="1">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Left" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#FF3A3060" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                                    <Setter Property="Background" Value="#FFDD2255" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                                    <Setter Property="Background" Value="#FFCC4400" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                                    <Setter Property="Background" Value="#FF997700" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                                                    <Setter Property="Background" Value="#FF4040C0" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Severity}" Foreground="#FFD0C8E0" FontSize="10" FontWeight="Bold" />
                                                                </Border>
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Category}" Foreground="{StaticResource AccentBlueBrush}"
                                                                           FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontWeight="Bold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#FFC8C0D8" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                                    <Setter Property="Foreground" Value="#FFDD6060" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                                    <Setter Property="Foreground" Value="#FFEE4455" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Description}" Foreground="#FFB0A8C0"
                                                                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding MatchedLogLine}" Foreground="#FF9088A8"
                                                                       FontSize="10" FontFamily="Cascadia Code,Consolas" Margin="0,4,0,0"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding MatchedLogLine}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListViewItem">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                        </ListView>
                                    </DockPanel>
                                </Border>

                                <!-- Tab status -->
                                <Border Grid.Row="3" Background="{StaticResource BgMediumBrush}" Padding="8,4"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock Text="{Binding FilteredLines, StringFormat='Showing: {0}'}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,15,0" />
                                            <TextBlock Text="{Binding TotalLines, StringFormat='Total: {0}'}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,15,0" />
                                            <TextBlock Text="{Binding ErrorCount, StringFormat='Errors: {0}'}"
                                                       Foreground="#FFDD5555" FontSize="11" FontWeight="Bold" Margin="0,0,15,0" />
                                            <TextBlock Text="{Binding WarningCount, StringFormat='Warnings: {0}'}"
                                                       Foreground="#FFD4B040" FontSize="11" FontWeight="Bold" Margin="0,0,15,0" />
                                            <TextBlock Text="{Binding IssueCount, StringFormat='Issues: {0}'}"
                                                       Foreground="#FF00CCFF" FontSize="11" FontWeight="Bold" />
                                        </StackPanel>
                                        <TextBlock />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <!-- Empty state -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Tabs.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="No log files open" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Click Open File or Auto-Detect above" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- PERFORMANCE PANEL -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActivePanel}" Value="Performance">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel Margin="24">
                    <!-- Header with refresh button -->
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="SYSTEM &amp; DCS INFO" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"
                                   FontSize="20" Margin="0" />
                        <Button DockPanel.Dock="Right" Content="Refresh All" Style="{StaticResource ToolbarButton}"
                                FontSize="12" Padding="14,8" HorizontalAlignment="Right"
                                Command="{Binding Performance.RefreshInfoCommand}" />
                    </DockPanel>

                    <!-- === PROCESSOR === -->
                    <Border Style="{StaticResource CardBorder}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="PROCESSOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"
                                       Margin="0,0,0,10" />
                            <TextBlock Text="{Binding Performance.CpuName}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cores / Threads" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Performance.CpuCores}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Max Speed" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Performance.CpuSpeed}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- === GPU(s) === -->
                    <ItemsControl ItemsSource="{Binding Performance.Gpus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Padding="20,16">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="GRAPHICS" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBlueBrush}" />
                                            <TextBlock Grid.Column="1" FontSize="10" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                <Setter Property="Text" Value="PRIMARY (PCIe)" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDedicated}" Value="False">
                                                                <Setter Property="Text" Value="INTEGRATED (iGPU)" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,8"
                                                   TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="VRAM" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Vram}" FontSize="14"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Driver Version" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding DriverVersion}" FontSize="14"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <!-- Upscaling tech row — only on primary GPU -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding UpscaleLabel1}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding UpscaleValue1}" FontSize="14"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSecondUpscale}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding UpscaleLabel2}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding UpscaleValue2}" FontSize="14"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- === MEMORY === -->
                    <Border Style="{StaticResource CardBorder}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="MEMORY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"
                                       Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Total RAM" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Performance.RamTotal}" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource AccentGreenBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Available" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Performance.RamAvailable}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Page File" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Performance.PageFileInfo}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- === OPERATING SYSTEM === -->
                    <Border Style="{StaticResource CardBorder}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="OPERATING SYSTEM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"
                                       Margin="0,0,0,10" />
                            <TextBlock Text="{Binding Performance.OsName}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Performance.OsBuild}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- === DCS INSTALLATION === -->
                    <Border Style="{StaticResource CardBorder}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="DCS WORLD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"
                                       Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Install Path" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Config.DcsInstallPath}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Variant" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Config.DcsVariant}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Saved Games" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Config.DcsSavedGamesPath}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Drive info -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- DCS Install Drive (clickable) -->
                                <Button Grid.Column="0" Cursor="Hand"
                                        Command="{Binding Performance.OpenInstallDriveCommand}"
                                        ToolTip="Open DCS install folder in Explorer">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="4" Padding="14,10"
                                                    x:Name="DriveCard">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="DCS Install Drive" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Performance.DcsInstallDriveType}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Performance.DcsInstallDriveFormat}" FontSize="10"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Performance.DcsInstallDrive}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                                    <!-- Usage bar -->
                                                    <Grid Margin="0,8,0,0" Height="6">
                                                        <Border Background="#FF2A2440" CornerRadius="3" />
                                                        <Border CornerRadius="3" HorizontalAlignment="Left"
                                                                Width="{Binding Performance.DcsInstallDriveUsagePercent, Converter={x:Static converters:PercentToWidthConverter.Instance}}">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#FF00AADD" Offset="0" />
                                                                    <GradientStop Color="#FF0088BB" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Performance.DcsInstallDriveUsed}" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Performance.DcsInstallFreeSpace}" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DriveCard" Property="Background" Value="#FF2E2848" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Saved Games Drive (clickable) -->
                                <Button Grid.Column="2" Cursor="Hand"
                                        Command="{Binding Performance.OpenSavedGamesDriveCommand}"
                                        ToolTip="Open Saved Games folder in Explorer">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="4" Padding="14,10"
                                                    x:Name="DriveCard">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Saved Games Drive" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Performance.SavedGamesDriveType}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Performance.SavedGamesDriveFormat}" FontSize="10"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Performance.SavedGamesDrive}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                                    <!-- Usage bar -->
                                                    <Grid Margin="0,8,0,0" Height="6">
                                                        <Border Background="#FF2A2440" CornerRadius="3" />
                                                        <Border CornerRadius="3" HorizontalAlignment="Left"
                                                                Width="{Binding Performance.SavedGamesDriveUsagePercent, Converter={x:Static converters:PercentToWidthConverter.Instance}}">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#FFFF2D78" Offset="0" />
                                                                    <GradientStop Color="#FFCC2060" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Performance.SavedGamesDriveUsed}" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Performance.SavedGamesFreeSpace}" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DriveCard" Property="Background" Value="#FF2E2848" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- === DXVK STATUS === -->
                    <Border Style="{StaticResource CardBorder}" Padding="20,16">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="Bold" Margin="0,0,0,10">
                                <Hyperlink NavigateUri="https://github.com/doitsujin/dxvk"
                                           RequestNavigate="Hyperlink_RequestNavigate"
                                           Foreground="{StaticResource AccentBlueBrush}" TextDecorations="None">
                                    DXVK STATUS
                                </Hyperlink>
                            </TextBlock>
                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="4" Padding="12,8" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Performance.DxvkStatusText}" FontSize="14"
                                           Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4">
                                DXVK translates DirectX 11 calls to the Vulkan graphics API. While it can reduce CPU overhead in some scenarios, it is highly experimental for DCS World.
                            </TextBlock>
                            <Border Background="#FF1A1028" CornerRadius="4" Padding="12,8" Margin="0,6,0,0"
                                    BorderBrush="#FF6644AA" BorderThickness="1">
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FFFF6090" FontWeight="SemiBold">
                                    Not recommended for installation at this time. DXVK can cause graphical glitches, crashes, and multiplayer integrity check failures. Use at your own risk.
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- === CACHE MANAGEMENT === -->
                    <Border Style="{StaticResource CardBorder}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="CACHE MANAGEMENT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"
                                       Margin="0,0,0,10" />
                            <TextBlock Text="Clear caches after DCS updates to fix stutters and graphical glitches. DCS will rebuild them on next launch."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                            <!-- Cache sizes -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Shader Cache" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Performance.ShaderCacheSize}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Terrain Cache" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Performance.TerrainCacheSize}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Total" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Performance.TotalCacheSize}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentGreenBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Clear Shader Cache" Style="{StaticResource ToolbarButton}" FontSize="12" Padding="14,8"
                                        Command="{Binding Performance.ClearShaderCacheCommand}" />
                                <Button Content="Clear Terrain Cache" Style="{StaticResource ToolbarButton}" FontSize="12" Padding="14,8"
                                        Command="{Binding Performance.ClearTerrainCacheCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status message -->
                    <TextBlock Text="{Binding Performance.StatusMessage}" FontSize="12"
                               Foreground="{StaticResource AccentGreenBrush}" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ======== FPS OPTIMIZATION PANEL ======== -->
        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActivePanel}" Value="FpsGuide">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel MaxWidth="900">

                    <!-- Header -->
                    <TextBlock Text="DCS OPTIMIZATION" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                    <TextBlock Text="Improve your DCS World frame rates and reduce stutters"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,20" />

                    <!-- DCS-Max Card -->
                    <Border Style="{StaticResource CardBorder}" Padding="24,20">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DCS-Max" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBlueBrush}" />
                                <TextBlock Grid.Column="1" Text="FREE &amp; OPEN SOURCE" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="The Ultimate DCS World Performance Optimization Suite"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,16" />

                            <!-- What it does -->
                            <TextBlock Text="WHAT IT DOES" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,8" />

                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="4" Padding="16,12" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}">
                                        DCS-Max automates the tedious process of finding your best DCS settings. It benchmarks
                                        128+ graphics setting combinations, disables Windows background services that cause stutters,
                                        and provides safe backup/restore for everything it touches.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Key Features -->
                            <TextBlock Text="KEY FEATURES" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,16,0,8" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="4" Padding="12,10" Margin="0,0,4,4">
                                    <StackPanel>
                                        <TextBlock Text="Automated Benchmarking" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Tests 128+ DCS graphics combinations with CapFrameX — find your optimal settings automatically"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="4" Padding="12,10" Margin="4,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="Windows Optimization" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Disables unnecessary services, tasks, and telemetry that cause frame drops and stutters"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="4" Padding="12,10" Margin="0,0,4,4">
                                    <StackPanel>
                                        <TextBlock Text="Safe Backups" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Full backup and restore for DCS configs, Windows registry, services, and scheduled tasks"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="4" Padding="12,10" Margin="4,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="Graphical Interface" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Modern UI — no command line needed. Visual dashboard, one-click backup, and easy optimization"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="4" Padding="12,10" Margin="0,0,4,4">
                                    <StackPanel>
                                        <TextBlock Text="VR Support" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="VR-specific optimization settings and Pimax Play integration for headset users"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="4" Padding="12,10" Margin="4,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="Cache Cleaning" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Clears NVIDIA shader cache, DX cache, and DCS caches to fix stale shader issues"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Typical Results -->
                            <TextBlock Text="TYPICAL RESULTS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,12,0,8" />

                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="4" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="15-30%" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="FPS Increase" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="Less" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Stuttering" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="Faster" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Mission Loading" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <TextBlock Text="Stable" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="VR Performance" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Requirements -->
                            <TextBlock Text="REQUIREMENTS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,16,0,8" />

                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="4" Padding="16,12">
                                <StackPanel>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                                        Windows 10/11 (64-bit) with Admin privileges. DCS-Max will also prompt you to install
                                        AutoHotkey v2, CapFrameX, and Notepad++ if needed — all free tools.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Safety Note -->
                            <TextBlock Text="SAFETY" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,16,0,8" />

                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="4" Padding="16,12">
                                <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                                    DCS-Max creates full backups before changing anything. Registry, services, scheduled tasks,
                                    and DCS configs are all backed up with one-click restore scripts. Always create a Windows
                                    System Restore point before running optimizations.
                                </TextBlock>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Content="Download DCS-Max" Style="{StaticResource ToolbarButton}"
                                        FontSize="14" Padding="20,10" FontWeight="SemiBold"
                                        Foreground="#FF00CCFF"
                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="https://github.com/thomas-barrios/DCS-Max/releases" />
                                <Button Content="View on GitHub" Style="{StaticResource ToolbarButton}"
                                        FontSize="13" Padding="16,10"
                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="https://github.com/thomas-barrios/DCS-Max/tree/master" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Quick Start -->
                    <Border Style="{StaticResource CardBorder}" Padding="24,20" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="QUICK START" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="1." FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreenBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8">
                                    Download the latest release ZIP from the button above and extract it to a folder
                                </TextBlock>

                                <TextBlock Grid.Row="1" Text="2." FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreenBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8">
                                    Create a Windows System Restore point (critical safety step)
                                </TextBlock>

                                <TextBlock Grid.Row="2" Text="3." FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreenBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8">
                                    Double-click DCS-Max.bat to launch the graphical interface
                                </TextBlock>

                                <TextBlock Grid.Row="3" Text="4." FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreenBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8">
                                    Use the Backup feature first, then run a baseline benchmark
                                </TextBlock>

                                <TextBlock Grid.Row="4" Text="5." FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreenBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap">
                                    Apply optimizations and re-benchmark to compare results in CapFrameX
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ======== WINDOWS TWEAKS PANEL ======== -->
        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActivePanel}" Value="WinTweaks">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel MaxWidth="900">

                    <!-- Header -->
                    <TextBlock Text="WINDOWS OPTIMIZATION" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                    <TextBlock Text="Debloat, tweak, and optimize Windows for better gaming performance"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,20" />

                    <!-- WinUtil Card -->
                    <Border Style="{StaticResource CardBorder}" Padding="24,20">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="WinUtil" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBlueBrush}" />
                                <TextBlock Grid.Column="1" Text="by Chris Titus Tech" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="The Ultimate Windows Utility — Install, Debloat, Tweak, and Fix"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,16" />

                            <!-- What it does -->
                            <TextBlock Text="WHAT IT DOES" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,8" />

                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="4" Padding="16,12" Margin="0,0,0,6">
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}">
                                    WinUtil is a free PowerShell utility that streamlines Windows setup and optimization.
                                    It can bulk-install programs, remove bloatware, apply performance tweaks, fix Windows
                                    Update issues, and configure privacy settings — all through a clean graphical interface.
                                    No installation needed, just one command.
                                </TextBlock>
                            </Border>

                            <!-- Key Features -->
                            <TextBlock Text="KEY FEATURES" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,16,0,8" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="4" Padding="12,10" Margin="0,0,4,4">
                                    <StackPanel>
                                        <TextBlock Text="Bulk App Install" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Install dozens of popular apps at once using winget — browsers, tools, runtimes, all in a few clicks"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="4" Padding="12,10" Margin="4,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="Windows Debloat" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Remove pre-installed bloatware, disable telemetry, and strip unnecessary Windows features"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="4" Padding="12,10" Margin="0,0,4,4">
                                    <StackPanel>
                                        <TextBlock Text="Performance Tweaks" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Apply gaming-focused optimizations to services, scheduled tasks, power plans, and network settings"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="4" Padding="12,10" Margin="4,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="Windows Update Fix" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Reset and repair broken Windows Update components when updates fail or get stuck"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="4" Padding="12,10" Margin="0,0,4,4">
                                    <StackPanel>
                                        <TextBlock Text="Privacy Controls" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Disable tracking, telemetry, Cortana, and other privacy-invasive Windows features"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="4" Padding="12,10" Margin="4,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="No Install Required" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Runs directly from PowerShell with a single command — nothing to download or install first"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Launch Command -->
                            <TextBlock Text="ONE-LINE LAUNCH" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,16,0,8" />

                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="4" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Open PowerShell as Administrator and paste this command:"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#FF1A1430" CornerRadius="4" Padding="14,10">
                                            <TextBox Text="irm &quot;https://christitus.com/win&quot; | iex"
                                                     FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"
                                                     Foreground="{StaticResource AccentGreenBrush}"
                                                     Background="Transparent" BorderThickness="0"
                                                     IsReadOnly="True" />
                                        </Border>
                                        <Button Grid.Column="1" Content="Copy" Style="{StaticResource ToolbarButton}"
                                                FontSize="12" Padding="14,8" Margin="6,0,0,0"
                                                Click="CopyWinUtilCommand_Click" />
                                    </Grid>
                                    <TextBlock Text="This downloads and runs the latest stable version directly."
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Safety Note -->
                            <TextBlock Text="GOOD TO KNOW" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,16,0,8" />

                            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="4" Padding="16,12">
                                <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                                    WinUtil must run as Administrator since it modifies system-level settings. It is open
                                    source with thousands of contributors reviewing the code. Create a System Restore point
                                    before applying tweaks so you can easily roll back any changes you don't like.
                                </TextBlock>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Content="View on GitHub" Style="{StaticResource ToolbarButton}"
                                        FontSize="14" Padding="20,10" FontWeight="SemiBold"
                                        Foreground="#FF00CCFF"
                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="https://github.com/ChrisTitusTech/winutil" />
                                <Button Content="Documentation" Style="{StaticResource ToolbarButton}"
                                        FontSize="13" Padding="16,10"
                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="https://christitustech.github.io/winutil/" />
                                <Button Content="YouTube Tutorial" Style="{StaticResource ToolbarButton}"
                                        FontSize="13" Padding="16,10"
                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="https://www.youtube.com/watch?v=6UQZ5oQg8XA" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Quick Start -->
                    <Border Style="{StaticResource CardBorder}" Padding="24,20" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="QUICK START" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="1." FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreenBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8">
                                    Right-click Start Menu and open "Terminal (Admin)" or "PowerShell (Admin)"
                                </TextBlock>

                                <TextBlock Grid.Row="1" Text="2." FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreenBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8">
                                    Paste the launch command above and press Enter — the WinUtil GUI will open
                                </TextBlock>

                                <TextBlock Grid.Row="2" Text="3." FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreenBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8">
                                    Use the Tweaks tab to select gaming and performance optimizations you want
                                </TextBlock>

                                <TextBlock Grid.Row="3" Text="4." FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreenBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap">
                                    Click "Run Tweaks" and restart when prompted — that's it
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ======== GLOBAL STATUS BAR ======== -->
        <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource BgMediumBrush}"
                Padding="12,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding GlobalStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
        </Border>
    </Grid>
</Window>
